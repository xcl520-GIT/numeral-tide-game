# ============================================================
#  数值潮汐 · 属性声明
#
#  这个项目在 Windows 上开发，但源码本身是跨平台的文本文件。
#  统一按 LF 入库，避免"同一份文件换台机器 diff 出一整屏"——
#  那种 diff 会把真正的改动淹掉。
# ============================================================

* text=auto eol=lf

# 二进制：不做行尾转换，也不参与文本 diff
*.png  binary
*.ico  binary
*.dll  binary
*.exe  binary
*.zip  binary

# 这些文件必须保持 ASCII（PowerShell 5.1 对它们的解析有讲究）
*.ps1  text eol=crlf
